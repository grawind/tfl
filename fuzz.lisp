(ql:quickload "cl-ppcre")

(defun random-word (n)
  (let ((s "")
        (alphabet "abc"))
    (dotimes (i n s)
      (setf s (concatenate 'string s
                           (string (char alphabet (random 3))))))))

(defun check-word (word)
  (let ((pattern "^(aaa|bbb|cc|ab(ccc)*|aa)*(aa|bbb|aab(cc)*|bbbb)*(aaa|bbb|cc|ab(ccc)*|aa)*$"))
    (not (null (cl-ppcre:scan-to-strings pattern word)))))

(defparameter DFA
  '((19 20 21 1) (28 29 27 1) (28 29 2 1) (3 34 27 1) (19 5 21 1)
    (25 6 27 1) (25 4 27 1) (25 7 27 1) (11 34 27 1) (25 43 10 1)
    (28 29 9 1) (8 47 27 1) (19 20 12 1) (13 17 21 1) (19 15 21 1)
    (19 16 21 1) (25 14 27 1) (19 52 18 1) (-1 -1 12 -1) (49 50 -1 -1)
    (-1 22 -1 -1) (-1 -1 0 -1) (-1 23 -1 -1) (19 24 21 1) (25 26 27 1)
    (38 32 -1 -1) (-1 4 -1 -1) (-1 -1 1 -1) (31 32 -1 -1) (-1 30 -1 -1)
    (-1 1 -1 -1) (3 29 27 1) (28 29 33 1) (-1 -1 2 -1) (28 35 33 1)
    (-1 36 -1 -1) (28 37 27 1) (28 35 27 1) (8 39 27 1) (25 40 41 1)
    (-1 7 -1 -1) (-1 -1 42 -1) (25 43 41 1) (-1 44 -1 -1) (-1 45 -1 -1)
    (25 46 27 1) (25 40 27 1) (25 40 48 1) (-1 -1 9 -1) (13 51 21 1)
    (19 20 18 1) (25 26 41 1) (-1 14 -1 -1)))

(defun checkDFA (word)
  (let ((current-state 0))
    (loop for c across word do
         (let ((ind (- (char-code c) 97)))
           (if (> (nth ind (nth current-state DFA)) -1)
               (setf current-state (nth ind (nth current-state DFA)))
               (return-from checkDFA nil))))
    (= (nth 3 (nth current-state DFA)) 1)))

(defparameter fin-NFA '(2))

(defparameter NFA
  '(((3) (5) (7) (1))
    ((11) (13) () (2))
    ((18) (20) (22) ())
    ((0 4) (8) () ())
    ((0) () () ())
    (() (6) () ())
    (() (0) () ())
    (() () (0) ())
    (() () (9) (0))
    (() () (10) ())
    (() () (8) ())
    ((1 12) () () ())
    (() (16) () ())
    (() (14) () ())
    (() (1 15) () ())
    (() (1) () ())
    (() () (17) (1))
    (() () (16) ())
    ((2 19) (23) () ())
    ((2) () () ())
    (() (21) () ())
    (() (2) () ())
    (() () (2) ())
    (() () (24) (2))
    (() () (25) ())
    (() () (2) ())))

(defun checkNFA (word &optional (state 0))
  (if (zerop (length word))
      (if (member state fin-NFA)
          t
          (some (lambda (i) (checkNFA word i))
                (nth 3 (nth state NFA))))
      (let ((letter (char word 0)))
        (or (some (lambda (i) (checkNFA (subseq word 1) i))
                  (nth (- (char-code letter) 97) (nth state NFA)))
            (some (lambda (i) (checkNFA word i))
                  (nth 3 (nth state NFA)))))))

(defparameter AFA
  (append DFA
          '((54 55 56 1)
            (57 58 56 -1)
            (54 58 56 -1)
            (54 55 59 -1)
            (57 58 56 1)
            (54 58 56 1)
            (54 55 59 1))))

(defun checkAFA (word)
  (let ((current-state1 0)
        (current-state2 53))
    (loop for c across word do
         (let ((ind (- (char-code c) 97)))
           (if (and (> (nth ind (nth current-state1 AFA)) -1)
                    (> (nth ind (nth current-state2 AFA)) -1))
               (progn
                 (setf current-state1 (nth ind (nth current-state1 AFA)))
                 (setf current-state2 (nth ind (nth current-state2 AFA))))
               (return-from checkAFA nil))))
    (and (= (nth 3 (nth current-state1 AFA)) 1)
         (= (nth 3 (nth current-state2 AFA)) 1))))

(defun run-tests ()
  (let ((g t))
    (dotimes (i 100)
      (dotimes (j 20)
        (let* ((word (random-word j))
               (t1 (check-word word))
               (t2 (checkDFA word))
               (t3 (checkNFA word))
               (t4 (checkAFA word)))
          (unless (and (equal t1 t2) (equal t1 t3) (equal t1 t4))
            (format t "~A тест провален~%" word)
            (format t "~A ~A ~A ~A~%" t1 t2 t3 t4)
            (setf g nil)))))
    (if g
        (format t "все тесты пройдены~%")
        (format t "не все тесты пройдены~%"))))


(run-tests)